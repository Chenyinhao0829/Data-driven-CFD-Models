def triangles_to_edges(faces):
    
    edges = torch.cat([faces[:, 0:2],
                       faces[:, 1:3],
                       torch.stack([faces[:, 2], faces[:, 0]], axis=1)], dim=0)
    receivers = tf.reduce_min(edges, axis=1)
    senders = tf.reduce_max(edges, axis=1)
    packed_edges = tf.bitcast(tf.stack([senders, receivers], axis=1), tf.int64)
    df = pd.DataFrame(packed_edges)
    unique_edges = df.drop_duplicates()
    unique_edges = tf.convert_to_tensor(unique_edges)
    senders, receivers = tf.unstack(unique_edges, axis=1)
    return (tf.concat([senders, receivers], axis=0),
          tf.concat([receivers, senders], axis=0))

def get_dataset(path):
    
    vtu_files = sorted([f for f in os.listdir(path) if f.endswith('.vtu')])
    print('文件数量为', len(vtu_files))

    all_speed = []
    
    for filename in vtu_files:
        mesh = meshio.read(os.path.join(path, filename))
        Speed = torch.tensor(mesh.point_data["Speed"]).float()
        all_speed.append(Speed)

    Speed_combined = torch.vstack(all_speed)
    print('合并后的矩阵规模为', Speed_combined.shape)
    return Speed_combined, mesh

def make_animation(mesh, speed_data):
    
    fig, ax = plt.subplots(1, 1, figsize=(20, 16))
    ax.set_aspect('equal')
    ax.set_axis_off()

    pos = mesh.points[:, :2]
    faces = mesh.get_cells_type('triangle')
    triang = mtri.Triangulation(pos[:, 0], pos[:, 1], faces)

    norm = colors.Normalize(vmin=speed_data.min(), vmax=speed_data.max())

    mesh_plot = ax.tripcolor(triang, speed_data[0].numpy(), cmap='rainbow', norm=norm, shading='flat')
    ax.triplot(triang, 'ko-', ms=0.5, lw=0.3)

    divider = make_axes_locatable(ax)
    cax = divider.append_axes('right', size='5%', pad=0.05)
    clb = fig.colorbar(mesh_plot, ax=ax, cax=cax, orientation='vertical')
    clb.ax.tick_params(labelsize=20)
    clb.ax.set_title('Speed (m/s)', fontdict={'fontsize': 20})

    def update(frame):
        ax.cla() 
        ax.set_aspect('equal')
        ax.set_axis_off()
        mesh_plot = ax.tripcolor(triang, speed_data[frame].numpy(), cmap='rainbow', norm=norm, shading='flat')
        ax.triplot(triang, 'ko-', ms=0.5, lw=0.3)
        return mesh_plot,
    plt.close(fig)
    ani = FuncAnimation(fig, update, frames=range(speed_data.shape[0]), blit=True, repeat=True)

    return ani


